# -- Runtime ------------------------------------------------
NODE_ENV=development
API_PORT=5243
LOG_LEVEL=debug

# -- Database (PostgreSQL) ---------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xophim

# -- KKPhim upstream ----------------------------------------
KKPHIM_BASE_URL=https://phimapi.com

# -- Web/API origins ----------------------------------------
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# -- Auth (Google OAuth, optional until configured) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5243/v1/auth/google/callback
SESSION_TTL_DAYS=30

# -- Static SPA (single-container deploy only) --------------
# WEB_STATIC_DIR=/app/apps/web/dist

# -- Web (Vite, exposed to client) --------------------------
VITE_API_BASE_URL=/v1
# Google Identity Services client id for the <GoogleLogin> button.
# MUST equal GOOGLE_CLIENT_ID above (the API verifies the ID token against it).
VITE_GOOGLE_CLIENT_ID=
