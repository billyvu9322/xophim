{
  "name": "@xophim/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "cross-env NODE_OPTIONS=--import=tsx drizzle-kit generate",
    "db:migrate": "cross-env NODE_OPTIONS=--import=tsx drizzle-kit migrate",
    "db:push": "cross-env NODE_OPTIONS=--import=tsx drizzle-kit push",
    "db:studio": "cross-env NODE_OPTIONS=--import=tsx drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.2",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "google-auth-library": "^9.15.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.6",
    "pg": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
