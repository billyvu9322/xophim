# ─────────────────────────────────────────────────────────────────────────
# XoPhim API — environment template. Copy to `.env` and fill in real values:
#   cp apps/api/.env.example apps/api/.env
# Env is validated once at boot (apps/api/src/config/env.ts); invalid config
# aborts startup. `.env` is auto-loaded from the api package dir AND the
# workspace root. NEVER commit a real `.env` (it holds secrets).
# ─────────────────────────────────────────────────────────────────────────

# --- Core ------------------------------------------------------------------
NODE_ENV=development
API_PORT=6001
# One of: fatal | error | warn | info | debug | trace (optional)
LOG_LEVEL=info

# --- Database (PostgreSQL, external / not containerized) --------------------
# REQUIRED. Must be a valid URL. From inside Docker use host.docker.internal.
DATABASE_URL=postgres://user:password@localhost:5432/xophim

# --- KKPhim content API (proxied by the CATALOG layer) ----------------------
# Defaults shown; override only if you mirror the upstream.
KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_CDN_URL=https://phimimg.com

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list of browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Auth: Google OAuth2 (optional until you enable Google sign-in) ---------
# Leave blank to disable Google SSO. Redirect URI must match Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:6001/v1/auth/google/callback

# Session cookie lifetime (days). Cookie maxAge = SESSION_TTL_DAYS * 86400.
SESSION_TTL_DAYS=30

# Where to redirect the browser after the OAuth callback (web origin).
WEB_ORIGIN=http://localhost:5173

# --- Single-image deploy only ----------------------------------------------
# Absolute path to the built SPA (apps/web/dist). Set in the Docker image so
# the API serves the static frontend. Leave unset in local dev (Vite serves).
# WEB_STATIC_DIR=/app/web
